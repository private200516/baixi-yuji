{
  "name": "baixi-yuji",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node tests/mobile-browser.mjs",
    "test:visual": "node tests/mobile-visual.mjs",
    "test:groove": "node tests/groove-navigation.mjs",
    "test:accessibility": "node tests/accessibility.mjs",
    "test:production": "node tests/production-smoke.mjs",
    "test:geography": "node tests/geography-browser.mjs",
    "test:round2": "node tests/round2-browser.mjs",
    "test:map-only": "node tests/map-only-browser.mjs",
    "test:town-scene": "node tests/town-scene-browser.mjs",
    "test:ui-motion": "node tests/ui-motion-browser.mjs",
    "test:round2-production": "node tests/round2-production.mjs",
    "test:map-depth": "node tests/map-depth-browser.mjs",
    "data:geography": "node scripts/prepare-geography.mjs",
    "data:routes": "node --experimental-strip-types scripts/prepare-route-research.mjs",
    "data:detail": "node scripts/prepare-village-detail.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.13.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "playwright": "1.63.0",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  }
}
